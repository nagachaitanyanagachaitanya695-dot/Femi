# =============================================================================
# Femi — environment variables
#
# Copy to .env.local and fill in what you need:
#   cp .env.example .env.local
#
# NEXT_PUBLIC_* variables are compiled into the browser bundle and are public.
# Everything else stays on the server. Never put a secret behind NEXT_PUBLIC_.
# .env.local is git-ignored — do not commit real keys.
# =============================================================================

# --- Required in production ---------------------------------------------------

# Signs the session cookie for the built-in auth backend. Generate one with:
#   openssl rand -base64 48
# Must be at least 32 characters. Changing it signs everyone out.
AUTH_SECRET=

# Your public site URL, used for canonical metadata, the sitemap and the
# password-reset redirect. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://femi.example.com


# --- Store settings -----------------------------------------------------------

# WhatsApp business number in international format: country code + number,
# digits only. India = 91 + 10 digits. Defaults to 919676877257.
NEXT_PUBLIC_WHATSAPP_NUMBER=919676877257

# Shown in the footer and on the policy pages.
NEXT_PUBLIC_SUPPORT_EMAIL=zubimoosa0813@gmail.com

# Comma-separated emails that get the admin role on sign-in. Use this to make
# yourself an admin the first time; after that, manage roles in the database.
FEMI_ADMIN_EMAILS=zubimoosa0813@gmail.com


# --- Supabase (optional; leave blank to use the built-in file store) ----------

# Project URL and publishable (anon) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. SERVER ONLY — it bypasses row-level security.
# Never prefix this with NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=


# --- Local file store (development only) --------------------------------------

# Where the JSON dev database is written. Defaults to ./.data
# FEMI_DATA_DIR=./.data
